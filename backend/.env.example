OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Model IDs (change freely when providers release new models)
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# true = always OCR the image and send text to Groq (needs Tesseract installed)
GROQ_FORCE_OCR=false

MAX_UPLOAD_MB=8
REQUEST_TIMEOUT=90
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
